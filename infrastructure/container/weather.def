Bootstrap: docker
From: continuumio/miniconda3:24.1.2-0

# ──────────────────────────────────────────────────────────────────────────────
# COSMO-REA6 Weather Pipeline — Apptainer Definition (deps-only)
# ──────────────────────────────────────────────────────────────────────────────
# Contains the conda environment and system tools ONLY.
# Source code is bind-mounted at runtime → no rebuild needed for code changes.
#
# Rebuild the image only when weather_env.yml changes (new/removed packages).
#
# ── Option 1 (recommended): Build on Snellius pbuild partition ───────────
#   cd ~/weather
#   bash scripts/build_container.sh def
#   # Submits a SLURM job to pbuild; SIF appears at ~/weather/weather.sif.
#
# ── Option 2: Build locally (needs root / sudo + Apptainer) ──────────────
#   cd /path/to/weather
#   sudo apptainer build weather.sif infrastructure/container/weather.def
#   scp weather.sif ssahoo@snellius.surf.nl:~/weather/
#
# ── Option 3: Docker → registry → pull on Snellius login node ────────────
#   LOCAL:     docker build -f infrastructure/container/Dockerfile -t weather .
#              docker tag weather docker.io/<user>/weather:latest
#              docker push docker.io/<user>/weather:latest
#   SNELLIUS:  apptainer pull docker://docker.io/<user>/weather:latest
#
# ── Run on Snellius ──────────────────────────────────────────────────────
#   sbatch scripts/run_pipeline_container.sh --months 1
#
# Source code is mounted at /app/src at runtime by run_pipeline_container.sh.
# Output: ~/weather/weather.sif (the repo root).
# ──────────────────────────────────────────────────────────────────────────────

%labels
    Author SomadSahoo
    Description Weather processing pipeline for UU-BUEM (deps-only)
    Version 2.0

%files
    infrastructure/env/weather_env.yml /opt/weather_env.yml

%environment
    export PATH=/opt/conda/envs/weather_env/bin:$PATH
    export CONDA_DEFAULT_ENV=weather_env
    export PYTHONPATH=/app/src
    export HDF5_USE_FILE_LOCKING=FALSE

%post
    # System tools (lbzip2/pbzip2 for parallel bzip2 decompression)
    apt-get update && apt-get install -y --no-install-recommends lbzip2 pbzip2 curl \
        && rm -rf /var/lib/apt/lists/*

    # Update conda to latest version, then create the weather environment
    /opt/conda/bin/conda update -n base -c defaults conda -y --quiet
    /opt/conda/bin/conda env create -f /opt/weather_env.yml
    /opt/conda/bin/conda clean -afy
    rm /opt/weather_env.yml

%runscript
    exec python -m weather "$@"

%test
    # Verify conda env and key packages are importable
    /opt/conda/envs/weather_env/bin/python -c "import xarray, cfgrib, netCDF4; print('OK: core packages importable')"
