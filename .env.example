# Weather pipeline configuration — copy to .env and adjust for your setup.
#
# Priority (highest wins):
#   1. CLI flag     --work-dir, --ncores, --year
#   2. This .env file
#   3. Built-in defaults listed below

# ── Paths ────────────────────────────────────────────────────────────────
#
# WEATHER_DATA_DIR — root for ALL provider data (COSMO-REA6, ERA5, MERRA2).
#   COSMO-REA6 data lands in <WEATHER_DATA_DIR>/cosmo_rea6/ unless you
#   also set COSMO_WORK_DIR below.
#
#   Local development (active default — change for HPC):
WEATHER_DATA_DIR=./data
#
#   HPC / shared storage example:
# WEATHER_DATA_DIR=/data/soma

# COSMO_WORK_DIR — COSMO-REA6 working root only.
#   Leave COMMENTED OUT to inherit <WEATHER_DATA_DIR>/cosmo_rea6 automatically.
#   Set this ONLY when COSMO data must live at a different absolute path than
#   the general data root (e.g. dedicated scratch volume on HPC), or when
#   you prefer to set the COSMO path explicitly without touching
#   WEATHER_DATA_DIR.
#
#   HPC example (both variables set to consistent absolute paths):
# WEATHER_DATA_DIR=/data/soma
# COSMO_WORK_DIR=/data/soma/cosmo_rea6

# ── Parallelism ───────────────────────────────────────────────────────────
#
# COSMO_NCORES — worker count for download + decompress steps.
#   The dask transform stage always saturates all available CPU cores
#   regardless of this value.
#   Falls back to SLURM_CPUS_PER_TASK if set by the job scheduler.
#
#   Local development:
# COSMO_NCORES=4
#   HPC 80-core node:
# COSMO_NCORES=80

#   HPC 96-core node (reserve 2 cores for OS / background daemons):
# COSMO_NCORES=94

# COSMO_THREADS_PER_JOB — bzip2 threads per decompression worker.
#   test_one_year.py runs up to ncores concurrent workers via ProcessPoolExecutor;
#   each worker should use exactly 1 thread to avoid oversubscription.
#   With lbzip2 or pbzip2 installed: set to 1 (C binary at 1 thread is
#   still faster than Python bz2 due to lower per-byte overhead).
#   Without them (Python bz2 fallback): setting is ignored (always 1 thread).
#
#   HPC (any core count with bulk parallel decompress):
# COSMO_THREADS_PER_JOB=1

# ── Year default ──────────────────────────────────────────────────────────
# Overridden by --year on the CLI.  Set here for bare
# `python test_one_year.py` invocations without a flag.
COSMO_YEAR=2018

# ── Logging ───────────────────────────────────────────────────────────────
# Log files land in <COSMO_WORK_DIR>/logs/ by default.
# Set to a path outside the data volume to avoid cluttering output:
# COSMO_LOG_DIR=/nethome/sahoo002/logs/cosmo_rea6

# ── Build ────────────────────────────────────────────────────────────────
# Keep conda-build scratch/artifacts inside the repository.
CONDA_BLD_PATH=./.conda-bld
