# Weather path configuration (copy to .env and adjust as needed)

# Root for weather runtime data (download/decompress/processed/output)
WEATHER_DATA_DIR=./data

# Provider-specific working root for COSMO-REA6
COSMO_WORK_DIR=./data/cosmo_rea6

# Keep conda-build scratch/artifacts inside the repository
CONDA_BLD_PATH=./.conda-bld

# Optional provider defaults
COSMO_YEAR=2018
COSMO_MONTHS=01,02,03,04,05,06,07,08,09,10,11,12
